#!/bin/sh
# pre-push — ruleaza automat la fiecare git push si il opreste daca pica.
# Activare, o singura data in clona:  git config core.hooksPath scripts/hooks
# Ocolire explicita, doar constient:  git push --no-verify
#
# De ce: verifica.sh citeste fisierele de pe disc, dar push-ul trimite
# commit-urile.  Daca arborele nu e curat, verificarea ar vedea altceva
# decat ce pleaca.  Demonstrat pe 27 sept 2026: "totul in regula" pe un
# commit cu hreflang rupt, reparat doar pe disc.

cd "$(git rev-parse --show-toplevel)" || exit 1

if [ -n "$(git status --porcelain)" ]; then
  echo "pre-push: exista modificari necomise — verificarea n-ar vedea ce pleaca." >&2
  git status --short >&2
  echo "pre-push: fa commit (sau git stash), apoi push din nou." >&2
  exit 1
fi

exec sh scripts/verifica.sh
